# Neon PostgreSQL — Pooler (runtime / Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — Direct (migraciones / prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# URL secreta del panel de administración  (ej: mi-clave-secreta-123)
ADMIN_SECRET="your-admin-secret"

# Vercel Blob — subida de imágenes de los desafíos
# Se genera automáticamente al crear un Blob Store en el dashboard de Vercel.
# Para probar la subida en local, copia aquí el token del store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
